# Copy to .env and fill in. NEVER commit .env. NEVER put these values in the app.
#
# The Anthropic API key lives here and ONLY here. If it ever reaches the phone,
# it can be extracted from the APK. That is the one unrecoverable mistake in
# this architecture.

ANTHROPIC_API_KEY=sk-ant-...

# Shared secret the app sends as `Authorization: Bearer <token>`.
# Generate one with:  openssl rand -hex 32
# Single-user only. This is NOT a safe auth scheme if the app is ever shared.
APP_BEARER_TOKEN=

PORT=8787

# --- Spend caps -------------------------------------------------------------
# Hard ceilings. When either is hit the server refuses AI calls until the next
# period. This exists so a retry loop cannot bill overnight.
#
# Raised from 25 when Phase 5 added the fourth paid feature. The sub-caps below
# plus the evaluation floor must fit inside this, and the server REFUSES TO
# START if they do not — so the number is a real budget, not a comment. At
# $8 + $5 + $4 + $2 + a $10 evaluation floor it is $29 of $30.
MONTHLY_USD_CAP=30

# Counts MODEL CALLS, not HTTP requests. One /evaluate is one call; one MCQ
# batch is two per chunk, so a 20-question batch is eight.
DAILY_REQUEST_CAP=120

# Per-endpoint sub-cap inside the monthly pool. Question banking is capped
# separately so a runaway banking loop cannot exhaust the shared wallet and
# block answer evaluation, which is the higher-value feature, for the rest of
# the month.
MCQ_MONTHLY_USD_CAP=8

# Held per requested question while a batch is in flight (x1.3 for top-ups).
ESTIMATED_MCQ_USD_PER_QUESTION=0.015

# Per-endpoint sub-cap for the daily current-affairs digest. Two model calls a
# day at roughly $0.12 is about $3.60 a month; five leaves room for a busy day
# and a retry. Unlike evaluation and banking this one runs every day the app is
# opened -- but it is PULLED, never pushed, so a week unopened costs nothing.
CA_MONTHLY_USD_CAP=5

# Held per digest while it is in flight. Order of magnitude, not billing truth.
ESTIMATED_CA_USD_PER_DIGEST=0.18

# Per-endpoint sub-cap for the essay and ethics drills. Two very different
# calls share it: setting prompts is cheap and happens twice a week, while
# MARKING is an evaluation-tier call on a piece of her writing and happens most
# mornings. Sized for the marking, and deliberately smaller than answer
# evaluation because a drill is a fifth of an answer.
DRILLS_MONTHLY_USD_CAP=4

# Held per prompt, and per marking call, while one is in flight.
ESTIMATED_DRILL_USD_PER_PROMPT=0.02
ESTIMATED_DRILL_EVAL_USD=0.08

# Per-endpoint sub-cap for interview question generation. The smallest of the
# four, and it should be: the DAF is filled over two years and generation is a
# handful of batches a month, rising only before the Personality Test.
INTERVIEW_MONTHLY_USD_CAP=2
ESTIMATED_INTERVIEW_USD=0.04

# Dollars the sub-caps may never collectively claim. Asserted AT BOOT: a set of
# explicit sub-caps that leaves less than this for answer evaluation refuses to
# start, rather than starving the highest-value feature silently in week two.
EVAL_RESERVED_FLOOR_USD=10

# The current-affairs source allowlist. Server config, never device data --
# adding a feed must not require an app rebuild. Defaults to the copy shipped
# beside the code, resolved relative to the module rather than to the working
# directory so a dist-only deploy resolves it too.
# CA_SOURCES_FILE=./src/ca/sources.json

# --- Providers (planned, not yet implemented) --------------------------------
# Decided 2026-09-08: Anthropic will not be used. Recorded here so the decision
# is not lost between now and the provider work, which is where these variables
# actually start being read.
#
#   PROVIDER_EVALUATION=gemini   marking answers and drills. Gemini because it
#                                is the only free-tier option with vision strong
#                                enough for handwritten exam answers, and the
#                                only one that takes a PDF natively — which is
#                                what the scanner-app capture path produces.
#   PROVIDER_BULK=groq           MCQ banking, the digest, drill prompts.
#
#   ALLOW_PERSONAL_DATA_TO=gemini
#
# That last one is the important one, and it is a SEPARATE axis from the
# evaluation/bulk tier split. The tiers are about cost; this is about content.
# `/interview` runs on the BULK tier — correctly, since generating "what is your
# district known for?" is not the hard part — but it sends the DAF verbatim:
# home district, family, employment, hobbies. A blanket "bulk goes to the free
# provider" rule would ship the most personal structured data in the app to a
# free tier without anyone deciding to.
#
# So each call site declares whether its payload is public or personal, and only
# the providers named here may receive personal payloads. A call site bound to a
# provider not on this list refuses at boot rather than at first request.
#
# One thing to know about the choice: Google's FREE tier generally uses inputs
# to improve their products in most regions. That covers the DAF and scans of
# handwriting. A PAID Gemini key does not have that property. This is a decision
# that was made deliberately, not an oversight.

# --- Models -----------------------------------------------------------------
# REQUIRED. The server refuses to start without both. Deliberately unset here:
# a model id is account-and-date specific, it goes stale when the provider
# retires a version, and a stale default fails at first request instead of at
# boot. Copy the exact ids from your provider's model list.
#
#   MODEL_EVALUATION  the strongest tier you are willing to pay for. It marks
#                     answers and drills, where judgement quality is the whole
#                     point, and the pricing below must match it.
#   MODEL_BULK        a cheaper, faster tier for high-volume, lower-stakes
#                     generation: MCQ banking, the daily digest, drill prompts.
MODEL_EVALUATION=
MODEL_BULK=

# --- Cost estimation --------------------------------------------------------
# USD per million tokens. These drive the local spend cap ONLY — they are not
# billing truth. VERIFY against your provider's current pricing and update these,
# otherwise your cap will be calibrated to the wrong numbers.
PRICE_EVAL_INPUT_PER_MTOK=15
PRICE_EVAL_OUTPUT_PER_MTOK=75
PRICE_BULK_INPUT_PER_MTOK=3
PRICE_BULK_OUTPUT_PER_MTOK=15

# Where the usage ledger is written.
USAGE_FILE=./data/usage.json

# --- Answer evaluation (Gemini) ----------------------------------------------
# The only configured provider that can serve /evaluate. Two reasons, both
# narrow: its vision is the strongest of the free tiers at handwriting, and it
# takes a PDF as a native document — which is what the phone scanner path she
# actually uses produces. Groq is refused on this tier AT BOOT, by capability,
# not by documentation.
#
# Get a key at https://aistudio.google.com/apikey and set both lines.
#
#   NOTE ON THE FREE TIER: Google generally uses free-tier inputs to improve
#   their products in most regions. On this route that means scans of her
#   handwriting. A PAID key does not have that property. Decided deliberately
#   on 2026-09-08 — see ALLOW_PERSONAL_DATA_TO above.
#
# PROVIDER_EVALUATION=gemini
# GEMINI_API_KEY=
# MODEL_EVALUATION=gemini-2.5-flash
#
# Before trusting a single mark, run the calibration in DEPLOYMENT.md: ten real
# scans, and gate on whether the TRANSCRIPTION matches what she wrote — not on
# whether the scores look plausible. A marking difference is arguable between
# two competent markers; a misread page is marking a different answer, and it
# presents as a perfectly normal-looking evaluation.
