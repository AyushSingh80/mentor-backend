# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

# android/ is deliberately NOT ignored. It is regenerable in principle, but it
# carries a hand-made fix — gradle-wrapper.properties raises networkTimeout
# from 10s to 300s, without which the 137MB Gradle distribution cannot be
# fetched and the build fails on a cold machine. Ignoring the folder loses that
# on every fresh clone, and the failure looks like a network problem rather
# than a missing setting. Track it until the fix lives in a config plugin.
